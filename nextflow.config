/*
========================================================================================
    nfvir Nextflow config file
========================================================================================
*/

// Global default params
params {
    // Print usage information and exit
    help = false

    // Input options
    assembly       = null   // single assembly FASTA (mutually exclusive with --assemblies)
    assemblies     = null   // CSV with columns: assemblyID, fasta
    reads          = null
    genomad_db     = null
    checkv_db      = null

    // Output options
    outdir                = './results'
    publish_dir_mode      = 'copy'
    download_publish_mode = 'move'

    // Process options
    max_cpus       = 8
    max_memory     = '32.GB'
    max_time       = '240.h'

    // geNomad: delete intermediate files after a successful run
    genomad_cleanup = true

    // Minimum CheckV quality tier retained for dereplication.
    // "all" keeps every contig (including "Not-determined").
    checkv_min_quality = 'all'

    // Use minimap2 instead of BWA for read mapping
    minimap = false

    // Suffix for the reports in pipeline_info/
    trace_report_suffix = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

    // Container options
    singularity_pull_docker_container = false
}

// Process configuration
process {
    // Default resources
    cpus   = { 1 * task.attempt }
    memory = { 6.GB * task.attempt }
    time   = { 4.h * task.attempt }

    // Upper bounds for any single task (set with --max_cpus/--max_memory/--max_time)
    resourceLimits = [
        cpus  : params.max_cpus,
        memory: params.max_memory,
        time  : params.max_time
    ]

    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    // Process-specific resource requirements
    withLabel: process_low {
        cpus   = { 2 * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel: process_download {
        cpus          = { 2 * task.attempt }
        memory        = { 8.GB * task.attempt }
        time          = { 8.h * task.attempt }
        errorStrategy = 'retry'
        maxRetries    = 2
    }
    withLabel: process_medium {
        cpus   = { 6 * task.attempt }
        memory = { 30.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
    withLabel: process_high {
        cpus   = { 8 * task.attempt }
        memory = { 30.GB * task.attempt }
        time   = { 16.h * task.attempt }
    }

    ext.singularity_pull_docker_container = params.singularity_pull_docker_container

    // Publishing directories
    withName: GENOMAD_ENDTOEND {
        publishDir = [
            path: { "${params.outdir}/genomad" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename.replaceFirst(/^genomad-out\//, '') }
        ]
    }

    withName: 'CHECKV_ENDTOEND' {
        // Outputs land in checkv-out/{assemblyID}/ — strip checkv-out/ to get
        // {assemblyID}/quality_summary.tsv etc. under results/checkv/
        publishDir = [
            path: { "${params.outdir}/checkv" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename.replaceFirst(/^checkv-out\//, '') }
        ]
    }

    withName: 'CHECKV_VOTUS' {
        // Strip checkv-out/{id}/ so files land flat in results/checkv-votus/
        publishDir = [
            path: { "${params.outdir}/checkv-votus" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename.replaceFirst(/^checkv-out\/[^\/]+\//, '') }
        ]
    }

    withName: 'MEGAHIT' {
        ext.args2 = ''
        publishDir = [
            path: { "${params.outdir}/assemblies" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: VOTUDEREP {
        ext.min_quality = params.checkv_min_quality
        publishDir = [
            path: { "${params.outdir}/dereplicated-votus" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: EXTRACT_REPSEQ {
        publishDir = [
            path: { "${params.outdir}/dereplicated-votus" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: BWA_MEM {
        // Sort alignments and write a CSI index next to each BAM
        ext.args2 = '--write-index'
        publishDir = [
            path: { "${params.outdir}/alignments" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: MINIMAP2_ALIGN {
        publishDir = [
            path: { "${params.outdir}/alignments" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: BAMCOUNTREFS {
        publishDir = [
            path: { "${params.outdir}/coverage" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}

// Execution profiles
profiles {
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        docker.registry        = 'quay.io'
        singularity.enabled    = false
        conda.enabled          = false
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.registry   = 'quay.io'
        docker.enabled         = false
        conda.enabled          = false
    }

    podman {
        podman.enabled         = true
        podman.registry        = 'quay.io'
    }

    conda {
        conda.enabled          = true
        docker.enabled         = false
        singularity.enabled    = false
    }

    standard {
        process.executor       = 'local'
    }

    test {
        params.assembly    = "${projectDir}/data/human_gut_assembly.fa.gz"
        params.assemblies  = null
        params.reads       = "${projectDir}/data/reads.csv"
        params.genomad_db  = 'stub_genomad_db'
        params.checkv_db   = 'stub_checkv_db'
        params.outdir      = "./test_results"
        params.max_cpus    = 4
        params.max_memory  = '16.GB'
        params.max_time    = '2.h'
    }
}

// Export these variables to prevent local Python/R libraries from conflicting with those in the container
env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'nfvir'
    author          = 'nfvir contributors'
    homePage        = 'https://github.com/nfvir/nfvir'
    description     = 'A simple viromics pipeline to mine viral genomes in a metagenome'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=25.10.0'
    version         = '2.0.0'
}

